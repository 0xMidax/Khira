# ───────── Required ─────────
# Docker compose only: password for the bundled Postgres, and the secret for the bundled Soketi (live updates)
POSTGRES_PASSWORD=
PUSHER_SECRET=
# Public address browsers use for live updates (Soketi). See docs/self-hosting.md
PUSHER_PUBLIC_HOST=localhost
PUSHER_PUBLIC_PORT=6001
PUSHER_PUBLIC_TLS=false

# Postgres (Neon in prod: use the *pooled* connection string). Omit locally to use embedded PGlite in ./.pglite
DATABASE_URL=
# 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. https://khira.yourteam.dev
BETTER_AUTH_URL=http://localhost:3000
# Other addresses people open Khira at, comma-separated (e.g. http://192.168.1.20:3000). Optional.
TRUSTED_ORIGINS=
# Who may sign up (the first user always can and becomes admin): domains and/or exact emails
ALLOWED_SIGNUPS=yourteam.dev,friend@gmail.com
# Email delivery (required in production: sign-ups verify their address and reset passwords).
# Either your own mail server…
SMTP_URL=
# …or Resend (also configurable on the Integrations page)
RESEND_API_KEY=
EMAIL_FROM="Khira <noreply@yourteam.dev>"
# Protects /api/cron/* (Vercel Cron sends it automatically when set in the project)
CRON_SECRET=

# ───────── Optional: each block switches a feature on ─────────
# Encrypts stored secrets (Discord webhooks, outgoing webhook keys). Defaults to a key derived from BETTER_AUTH_SECRET.
ENCRYPTION_KEY=

# Social sign-in (buttons appear only when set). Callback: <BETTER_AUTH_URL>/api/auth/callback/<google|github>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI (issue writer, plain-English search, summaries, standups, triage, release notes). Default model claude-opus-5-5.
ANTHROPIC_API_KEY=
AI_MODEL=

# File attachments in Cloudflare R2 (or any S3). Without these, files go to ./.uploads (dev only).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Live updates outside docker compose: Pusher Channels (cloud) or your own Soketi. Without these the app polls.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_CLUSTER=mt1
# For Soketi: PUSHER_HOST / PUSHER_PORT / PUSHER_TLS

# Web push (`npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourteam.dev

# Slack app: bot token (chat:write, commands, links:read, links:write) + signing secret
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Channel ID where daily standups are posted
STANDUP_SLACK_CHANNEL=

# GitHub: repo/org webhook → <BETTER_AUTH_URL>/api/webhooks/github (pull_request, push, create)
GITHUB_WEBHOOK_SECRET=

# Email to issue (Postmark inbound) → https://khira:<INBOUND_EMAIL_SECRET>@<host>/api/webhooks/email
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=

# Shared rate limiting across serverless instances (otherwise per-instance memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
